# Lore environment settings.
#
# Copy this file to `.env` in the repo root:   cp .env.example .env
# Never commit `.env` (it is in .gitignore). This file contains no real secrets.
#
# One file serves everything:
#   - `docker compose` reads it for the `api` container,
#   - the Makefile loads it before running backend commands (make api, make load, ...).
# Values with special characters (like JSON lists) go in single quotes.
#
# Every LORE_ setting below matches a field in backend/lore/config.py.
# A line that is commented out shows the default (or "unset"); uncomment it to change it.

# ---------------------------------------------------------------- FalkorDB
# `localhost` for local runs. Docker Compose overrides this to `falkordb` for the api container.
LORE_FALKORDB_HOST=localhost
LORE_FALKORDB_PORT=6379
# Leave unset locally. On the VM set a long random password, and set the same one in
# docker-compose.yml (REDIS_ARGS "--requirepass ...").
# LORE_FALKORDB_PASSWORD=
# One graph per company ("multigraph"). A second tenant could be org_demo2.
LORE_GRAPH_NAME=org_kettle
# A Cypher query that runs longer than this is cancelled (milliseconds).
LORE_QUERY_TIMEOUT_MS=2000

# ------------------------------------------------------------------ Gemini
# Get a key in Google AI Studio and enable billing (free-tier limits hurt during a live demo).
# Without a key, Lore can only run in replay mode (see LORE_FORCE_REPLAY).
# LORE_GEMINI_API_KEY=
# Model ids are placeholders: confirm the exact ids in AI Studio before the demo.
LORE_MODEL_PRO=gemini-3-pro-preview
LORE_MODEL_FLASH=gemini-3-flash-preview
LORE_MODEL_EMBED=gemini-embedding-001
# Vector size of the embeddings. The FalkorDB vector index must use the same number.
LORE_EMBED_DIM=768
# Offline mode: true if the graph was loaded with `make load-fake`. Query vectors must be made the
# same way as the stored ones, so the API, evals and MCP server all need this set to match.
LORE_FAKE_EMBEDDINGS=false

# ------------------------------------------- Outward actions (human approves first)
# Slack "incoming webhook" URL for the demo workspace. Unset = Slack posts are simulated.
# LORE_SLACK_WEBHOOK_URL=
# GitHub token with permission to create issues in the demo repo only. Unset = simulated.
# LORE_GITHUB_TOKEN=
# Demo repo that receives issues, written as owner/name.
# LORE_GITHUB_REPO=

# --------------------------------------------------------------------- Web
# Signs the session cookie. CHANGE THIS on the VM (e.g. `openssl rand -hex 32`).
LORE_SESSION_SECRET=dev-only-change-me
# Websites allowed to call the API from a browser. This is a JSON list, so keep the single quotes.
# On the VM add your Vercel URL, e.g. '["https://lore-demo.vercel.app"]'.
LORE_CORS_ORIGINS='["http://localhost:5173"]'
LORE_RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------ Replay mode
# Folder with recorded runs (relative to backend/).
LORE_REPLAY_DIR=replays
# true = never call Gemini, play back a recorded run instead (clearly labelled in the UI).
# Use this when quota runs out or Gemini is down.
LORE_FORCE_REPLAY=false

# ------------------------------------------------------------ Agent tuning
# If the Investigator is less sure than this, the Supervisor looks one more hop out.
LORE_INVESTIGATOR_CONFIDENCE_THRESHOLD=0.7
# Maximum tool calls one agent may make.
LORE_MAX_AGENT_STEPS=8

# ------------------------------------------------- Deployment (docker compose, prod profile)
# Your domain for HTTPS, e.g. lore.example.com. Its DNS A record must point at the VM.
# Only used by Caddy (docker compose --profile prod). Defaults to `localhost`.
# LORE_DOMAIN=lore.example.com

# ----------------------------------------------------------------- Frontend
# These do NOT go in this file. Vite reads them from frontend/.env (or frontend/.env.local),
# or from the Vercel project settings:
#
#   VITE_API_BASE=http://localhost:8000      # where the API lives (default shown). On Vercel: https://<LORE_DOMAIN>
#   VITE_MOCK=1                              # optional: run the UI on fake data, no backend (make mock)
