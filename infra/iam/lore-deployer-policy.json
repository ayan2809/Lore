{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployLoreStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "ec2:*",
        "ecs:*",
        "ecr:*",
        "elasticloadbalancing:*",
        "elasticfilesystem:*",
        "cloudfront:*",
        "codebuild:*",
        "logs:*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LoreBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::lore-*", "arn:aws:s3:::lore-*/*"]
    },
    {
      "Sid": "ListBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:GetBucketLocation"],
      "Resource": "*"
    },
    {
      "Sid": "LoreSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:*:355426657170:secret:lore/*"
    },
    {
      "Sid": "SecretsHelpers",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetRandomPassword", "secretsmanager:ListSecrets"],
      "Resource": "*"
    },
    {
      "Sid": "AwsManagedKeysViaServices",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey", "kms:CreateGrant", "kms:ListAliases"],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": [
            "elasticfilesystem.*.amazonaws.com",
            "secretsmanager.*.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "LoreRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": "arn:aws:iam::355426657170:role/lore-*"
    },
    {
      "Sid": "PassLoreRolesToEcsAndCodeBuild",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::355426657170:role/lore-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": ["ecs-tasks.amazonaws.com", "codebuild.amazonaws.com"]
        }
      }
    },
    {
      "Sid": "FirstUseServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::355426657170:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "elasticfilesystem.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadQuotas",
      "Effect": "Allow",
      "Action": ["servicequotas:GetServiceQuota", "servicequotas:ListServiceQuotas"],
      "Resource": "*"
    },
    {
      "Sid": "ReadServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::355426657170:role/aws-service-role/*"
    }
  ]
}
